# ============================================================
# Server mode: 'classic' | 'seasonal'
# ============================================================
SERVER=classic

# ============================================================
# Classic server
# ============================================================

# -- Database --
CLASSIC_PGHOST=string
CLASSIC_PGPORT=5432
CLASSIC_PGDATABASE=string
CLASSIC_PGUSER=string
CLASSIC_PGPASSWORD=string
CLASSIC_DB_SSL=true

# -- Scraper --
CLASSIC_BASE_URL=https://example.com
CLASSIC_HIGHSCORES_PAGES=10
CLASSIC_SERVER_TIMEZONE=America/New_York

# ============================================================
# Seasonal server
# ============================================================

# -- Database --
SEASONAL_PGHOST=string
SEASONAL_PGPORT=5432
SEASONAL_PGDATABASE=string
SEASONAL_PGUSER=string
SEASONAL_PGPASSWORD=string
SEASONAL_DB_SSL=true

# -- Scraper --
SEASONAL_BASE_URL=https://example.com
SEASONAL_HIGHSCORES_PAGES=10
SEASONAL_SERVER_TIMEZONE=America/New_York

# ============================================================
# Global (shared by both servers)
# ============================================================

# -- Fetch configuration --
FETCH_MAX_RETRIES=3
FETCH_TIMEOUT_MS=10000
FETCH_RETRY_DELAY_MS=5000

# -- Debug --
ENABLE_DEBUG=false

# ============================================================
# Local overrides (optional)
# ============================================================
# Create .env.classic.local or .env.seasonal.local to override
# any variable above for local / Docker development.
# These files are gitignored.
#
# Example .env.classic.local for Docker:
#   CLASSIC_PGHOST=db
#   CLASSIC_DB_SSL=false
# ============================================================
