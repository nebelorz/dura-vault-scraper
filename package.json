{
  "name": "dura-vault-scraper",
  "type": "commonjs",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "eslint": "eslint src --ext .ts --max-warnings 0",
    "start:db:classic": "cross-env SERVER=classic ts-node src/db/init-db.ts",
    "start:db:seasonal": "cross-env SERVER=seasonal ts-node src/db/init-db.ts",
    "start:highscores:scraper:classic": "cross-env SERVER=classic ts-node src/highscore/highscores-scraper.ts",
    "start:highscores:scraper:seasonal": "cross-env SERVER=seasonal ts-node src/highscore/highscores-scraper.ts",
    "start:highscores:daily-insert:classic": "cross-env SERVER=classic ts-node src/highscore/highscores-daily-insert.ts",
    "start:highscores:daily-insert:seasonal": "cross-env SERVER=seasonal ts-node src/highscore/highscores-daily-insert.ts",
    "start:online:scraper:classic": "cross-env SERVER=classic ts-node src/online/online-scraper.ts",
    "start:online:scraper:seasonal": "cross-env SERVER=seasonal ts-node src/online/online-scraper.ts",
    "start:online:daily-insert:classic": "cross-env SERVER=classic ts-node src/online/online-daily-insert.ts",
    "start:online:daily-insert:seasonal": "cross-env SERVER=seasonal ts-node src/online/online-daily-insert.ts",
    "start:deaths:scraper:classic": "cross-env SERVER=classic ts-node src/deaths/deaths-scraper.ts",
    "start:deaths:scraper:seasonal": "cross-env SERVER=seasonal ts-node src/deaths/deaths-scraper.ts",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.13.2",
    "cheerio": "^1.1.2",
    "dotenv": "^17.2.3",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/cheerio": "^0.22.35",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.6",
    "@typescript-eslint/eslint-plugin": "^8.48.1",
    "@typescript-eslint/parser": "^8.48.1",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "prettier": "^3.7.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1"
  },
  "directories": {
    "test": "tests"
  },
  "description": ""
}
