# ============================================================
# Seasonal server configuration
# ============================================================

# -- Compose --
SERVER=seasonal
COMPOSE_PROJECT_NAME=dura-vault-seasonal
HOST_PORT=5433

# -- Scraper --
# Base URL of the seasonal server (no trailing slash)
BASE_URL=https://aetas.playdura.com

# Number of highscore pages to scrape
HIGHSCORES_PAGES=10

# Timezone of the game server
SERVER_TIMEZONE=America/New_York

# -- Database --
PGHOST=aws-0-eu-west-1.pooler.supabase.com
PGPORT=6543
PGDATABASE=postgres
PGUSER=postgres.abc123
PGPASSWORD=password
DB_SSL=true

# ============================================================
# Local overrides (optional)
# ============================================================
# Create a .env.local file in this directory to override
# any variable above for local / Docker development.
# This file is gitignored.
#
# Example .env.local for Docker:
#   PGHOST=db
#   DB_SSL=false
# ============================================================
