# ============================================================
# Classic server configuration
# ============================================================

# -- Compose --
SERVER=classic
COMPOSE_PROJECT_NAME=dura-vault
HOST_PORT=5432

# -- Scraper --
# Base URL of the classic server (no trailing slash)
BASE_URL=https://classic.dura-online.com

# Number of highscore pages to scrape
HIGHSCORES_PAGES=10

# Timezone of the game server
SERVER_TIMEZONE=America/New_York

# -- Database --
PGHOST=localhost
PGPORT=5432
PGDATABASE=postgres
PGUSER=postgres
PGPASSWORD=password
DB_SSL=false

# ============================================================
# Local overrides (optional)
# ============================================================
# Create a .env.local file in this directory to override
# any variable above for local / Docker development.
# This file is gitignored.
#
# Example .env.local for Docker:
#   PGHOST=db
#   DB_SSL=false
# ============================================================
